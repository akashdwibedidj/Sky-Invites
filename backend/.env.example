# Environment: "development" or "production" (defaults to "production" if unset)
APP_ENV=development

OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_api_key_here

# LangSmith tracing (disabled by default; enabling sends invitation details to a third party)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=sky-invites

# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sky_invites

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_32_byte_random_hex_string_here

# Signed media URLs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEDIA_SIGNING_SECRET=generate_a_different_32_byte_random_hex_string_here

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000

# Razorpay (TEST MODE keys only; startup refuses non-rzp_test_ keys unless ALLOW_LIVE_PAYMENTS=true)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# ALLOW_LIVE_PAYMENTS=false
